# ---------------------------------------------------------------------------
# Arc — Circle's stablecoin-native L1. USDC is the gas token.
# ---------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_WS_URL=wss://rpc.testnet.arc.network
# Chain id 5042002. Explorer https://testnet.arcscan.app
# Fund test wallets at https://faucet.circle.com (select Arc Testnet).

# ---------------------------------------------------------------------------
# Circle developer platform — console.circle.com
# ---------------------------------------------------------------------------
# API key format: PREFIX:ID:SECRET
CIRCLE_API_KEY=
# 32-byte hex entity secret. Generate, then register its ciphertext with Circle
# before the first request or every call will fail.
ENTITY_SECRET=

# Circle's blockchain identifier for Arc in the Wallets / SCP APIs.
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# App ID for user-controlled wallets — console.circle.com → Programmable Wallets.
# Taskers and businesses hold their own keys; without this the app falls back to a
# demo wallet so the flow stays clickable, but no real wallet is created.
CIRCLE_APP_ID=

# The next four are printed by: npm run bootstrap -w @vane/contracts

# Holds every Vane user wallet.
CIRCLE_WALLET_SET_ID=

# The falcon's own wallet. It may call settle() and hold(); it never holds user funds.
CIRCLE_AGENT_WALLET_ID=

# The falcon's on-chain address — the only address the escrow accepts settle()/hold() from.
VANE_AGENT_ADDRESS=

# Smart Contract Platform ids, filled in by the deploy script.
CIRCLE_ESCROW_CONTRACT_ID=
CIRCLE_REGISTRY_CONTRACT_ID=

# ---------------------------------------------------------------------------
# Deployed contract addresses on Arc (filled in by the deploy script)
# ---------------------------------------------------------------------------
VANE_ESCROW_ADDRESS=
VANE_REGISTRY_ADDRESS=

# The stand-in advertiser used to demonstrate the loop end to end.
VANE_DEMO_BUSINESS_ADDRESS=

# Where the protocol fee is paid. Rate is set in the contract (feeBps), capped at 10%.
VANE_FEE_RECIPIENT=

# ---------------------------------------------------------------------------
# Local deploy only — a funded Arc testnet key, if deploying with Foundry
# instead of the Circle Smart Contract Platform.
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=

# Block the escrow was deployed at. The decision index scans back to here and no
# further — Arc caps eth_getLogs at 10k blocks and produces sub-second blocks, so an
# unbounded backfill is thousands of calls.
VANE_ESCROW_FROM_BLOCK=53930000

# Email delivery for login codes. Without it the code is shown on screen so the
# flow is still completable — see app/lib/auth-code.ts.
RESEND_API_KEY=
LOGIN_EMAIL_FROM=
