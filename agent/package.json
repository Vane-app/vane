{
  "name": "@vane/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Vane falcon \u2014 verifies results on Arc and settles USDC payouts autonomously.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "demo": "tsx src/demo.ts",
    "sybil": "tsx src/sybil.ts",
    "tasker": "tsx src/tasker.ts",
    "nano": "tsx src/nano.ts",
    "typecheck": "tsc --noEmit",
    "convert": "tsx src/convert.ts",
    "seed:live": "tsx src/seed-live.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/smart-contract-platform": "^10.8.0",
    "@circle-fin/x402-batching": "^3.2.0",
    "dotenv": "^17.2.3",
    "viem": "^2.55.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./decision": {
      "types": "./dist/decision.d.ts",
      "default": "./dist/decision.js"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "default": "./dist/signals.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./pass": {
      "types": "./dist/pass.d.ts",
      "default": "./dist/pass.js"
    }
  }
}
